[
  {
    "name": "web.cfg",
    "about": "examples/haproxy/web.cfg: a default backend, frontends that answer themselves",
    "config": "# A web load balancer on a Janus node: HTTP for the application on every\n# address, two application servers checked every 2 seconds, HAProxy's\n# own Prometheus exporter on :8405. Applied by the Terraform examples\n# (../terraform/*/main.tf); checked by the node's own HAProxy (make\n# examples-test). docs/haproxy-config.md says what differs from a\n# distribution's haproxy.cfg.\nglobal\n    log stdout format raw local0\n    stats socket /run/janus/haproxy-admin.sock mode 660 level admin\n    chroot /var/empty\n    uid 1000\n    gid 1000\n    # About 32000 connections and 20 MB of tables: enough for a small node.\n    fd-hard-limit 65536\n\ndefaults\n    mode http\n    log global\n    option httplog\n    timeout connect 5s\n    timeout client 30s\n    timeout server 30s\n\nfrontend web\n    bind :80\n    # HTTPS once the certificate is on the node (docs/haproxy-files.md):\n    #   bind :443 ssl crt /etc/haproxy/files/certs/app.pem alpn h2,http/1.1\n    http-request return status 200 content-type text/plain string \"ok\\n\" if { path /healthz }\n    default_backend app\n\nbackend app\n    balance roundrobin\n    option httpchk GET /healthz\n    default-server check inter 2s fall 3 rise 2\n    server app1 10.0.10.11:8080\n    server app2 10.0.10.12:8080\n\nfrontend prometheus\n    bind :8405\n    http-request use-service prometheus-exporter if { path /metrics }\n    no log\n",
    "backends": [
      "app"
    ],
    "maps": {},
    "want": {
      "frontends": [
        {
          "name": "web",
          "kind": "frontend",
          "mode": "http",
          "binds": [
            ":80"
          ],
          "answers": [
            "return"
          ]
        },
        {
          "name": "prometheus",
          "kind": "frontend",
          "mode": "http",
          "binds": [
            ":8405"
          ],
          "answers": [
            "use-service prometheus-exporter"
          ]
        }
      ],
      "backends": [
        "app"
      ],
      "maps": [],
      "links": [
        {
          "frontend": "web",
          "backend": "app",
          "rules": [
            {
              "text": "default_backend app"
            }
          ]
        }
      ],
      "unresolved": []
    }
  },
  {
    "name": "defaults and listen",
    "about": "use_backend rules, default_backend inherited from named defaults, listen sections, .if blocks read as held",
    "config": "\ndefaults base\n    mode http\n    default_backend fallback\ndefaults tcp from base\n    mode tcp\ndefaults\n    mode http\nfrontend fe1 from base\n    bind 10.0.0.1:443,10.0.0.1:8443 ssl crt /etc/haproxy/files/x.pem\n    use_backend api if { req.hdr(host) -i api.example.com }\n    use_backend \"static\" unless is_dynamic  # a comment\n    use_backend missing if never\nfrontend fe2 from tcp\n    bind :5432\nfrontend fe3\n    bind :81\n.if defined(DEBUG)\n    use_backend debug\n.endif\nlisten stats :8404\n    stats enable\n    stats uri /\nlisten pg\n    bind :5433\n    default_backend pg_replicas\nbackend api\nbackend static\nbackend fallback\nbackend debug\nbackend pg_replicas\n",
    "backends": [
      "stats",
      "pg",
      "api",
      "static",
      "fallback",
      "debug",
      "pg_replicas"
    ],
    "maps": {},
    "want": {
      "frontends": [
        {
          "name": "fe1",
          "kind": "frontend",
          "mode": "http",
          "binds": [
            "10.0.0.1:443,10.0.0.1:8443"
          ],
          "answers": []
        },
        {
          "name": "fe2",
          "kind": "frontend",
          "mode": "tcp",
