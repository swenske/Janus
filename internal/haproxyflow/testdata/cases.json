  {
    "name": "quotes and escapes",
    "about": "quoted words, escaped blanks, a quoted map path",
    "config": "\nfrontend \"front door\"\n    bind \":80\"\n    use_backend %[base,map_beg(\"/etc/haproxy/files/paths.map\")]\n    use_backend back\\ end if { path_beg /x }\n    http-request redirect scheme https unless { ssl_fc }\n    tcp-request content use-service lua.hello\nbackend \"back end\"\nbackend api\nbackend static\n",
    "backends": [
      "back end",
      "api",
      "static"
    ],
    "maps": {
      "/etc/haproxy/files/paths.map": {
        "/api": "api",
        "/nothing": "none",
        "/static": "static"
      }
    },
    "want": {
      "frontends": [
        {
          "name": "front door",
          "kind": "frontend",
          "mode": "",
          "binds": [
            ":80"
