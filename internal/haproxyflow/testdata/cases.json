  {
    "name": "maps and variables",
    "about": "use_backend through a map (prefix, suffix, default), through set-var with a str() literal, and per request",
    "config": "\nfrontend https\n    bind :443\n    use_backend be_%[req.hdr(host),lower,map(/etc/haproxy/files/hosts.map,default)]_pool\nfrontend vars\n    bind :80\n    http-request set-var(txn.be) req.hdr(host),lower,map_str(/etc/haproxy/files/vars.map) if { req.hdr(host) -m found }\n    http-request set-var(txn.be) str(be_api) if { path_beg /api }\n    use_backend %[var(txn.be)]\nfrontend opaque\n    bind :82\n    use_backend %[req.hdr(x-backend)]\nbackend be_www_pool\nbackend be_blog_pool\nbackend be_default_pool\nbackend be_api\nbackend be_a\n",
    "backends": [
      "be_www_pool",
      "be_blog_pool",
      "be_default_pool",
      "be_api",
      "be_a"
    ],
    "maps": {
      "/etc/haproxy/files/hosts.map": {
        "a.example.com": "a",
        "blog.example.com": "blog",
        "example.com": "www",
        "old.example.com": "gone",
        "www.example.com": "www"
      }
    },
    "want": {
      "frontends": [
        {
          "name": "https",
          "kind": "frontend",
          "mode": "",
          "binds": [
            ":443"
          ],
          "answers": []
        },
        {
          "name": "vars",
          "kind": "frontend",
          "mode": "",
          "binds": [
            ":80"
          ],
          "answers": []
        },
        {
          "name": "opaque",
          "kind": "frontend",
          "mode": "",
          "binds": [
            ":82"
          ],
          "answers": []
        }
      ],
      "backends": [
        "be_www_pool",
        "be_blog_pool",
        "be_default_pool",
        "be_api",
        "be_a"
      ],
      "maps": [
        "/etc/haproxy/files/hosts.map",
        "/etc/haproxy/files/vars.map"
      ],
      "links": [
        {
          "frontend": "https",
          "backend": "be_blog_pool",
          "rules": [
            {
              "text": "use_backend be_%[req.hdr(host),lower,map(/etc/haproxy/files/hosts.map,default)]_pool",
              "map": "/etc/haproxy/files/hosts.map",
              "keys": [
                "blog.example.com"
              ]
            }
          ]
        },
        {
          "frontend": "https",
          "backend": "be_www_pool",
          "rules": [
            {
              "text": "use_backend be_%[req.hdr(host),lower,map(/etc/haproxy/files/hosts.map,default)]_pool",
              "map": "/etc/haproxy/files/hosts.map",
              "keys": [
                "example.com",
                "www.example.com"
              ]
            }
          ]
        },
        {
          "frontend": "https",
          "backend": "be_default_pool",
          "rules": [
            {
              "text": "use_backend be_%[req.hdr(host),lower,map(/etc/haproxy/files/hosts.map,default)]_pool",
              "map": "/etc/haproxy/files/hosts.map",
              "isDefault": true
            }
          ]
        },
        {
          "frontend": "vars",
          "backend": "be_api",
          "rules": [
            {
              "text": "use_backend %[var(txn.be)]",
              "via": "set-var"
            }
          ]
        }
      ],
      "unresolved": [
        {
          "frontend": "opaque",
          "format": "%[req.hdr(x-backend)]",
          "maps": []
        }
      ]
    }
  },
