# janus.sw-servers.net - the Janus companion site (site/backend).
# Installed by site/deploy/setup-ct.sh; the binary is deployed by
# .github/workflows/site-deploy.yml. TLS is terminated by the front-end
# HAProxy, which forwards to :8080 with X-Forwarded-For.
[Unit]
Description=Janus companion site (janus.sw-servers.net)
# network.target, not network-online.target: the site only listens, and
# reaches GitHub lazily. The container's network is ifupdown's, so
# network-online pulled in systemd-networkd-wait-online, which waited
# its full 2 minutes on every start before failing.
After=network.target

[Service]
User=janus-site
Group=janus-site
UMask=0002
ExecStart=/srv/janus-site/bin/janus-site -addr :8080 -data-dir /srv/janus-site/data -public-url https://janus.sw-servers.net -github-token-file /etc/janus-site/github-token
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
ReadWritePaths=/srv/janus-site/data
# The rest of what systemd-analyze security asks for and a Go HTTP
# service can live with: sockets of the three families it uses, no
# namespaces, no realtime, no clock, no view of other processes, and
# the system-service syscall set (what a daemon serving HTTP needs)
# minus the privileged and resource-changing ones.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
