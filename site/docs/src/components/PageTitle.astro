---
// The page's title, with its breadcrumbs above it.
import Default from '@astrojs/starlight/components/PageTitle.astro'
import { breadcrumbs } from '../lib/breadcrumbs.mjs'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const crumbs = breadcrumbs(Astro.locals, base)
---

{
  crumbs.length > 0 && (
    <nav aria-label="Breadcrumbs" class="janus-breadcrumbs">
      <ol>
        {crumbs.map((c) => (
          <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>
        ))}
      </ol>
    </nav>
  )
}
<Default />
