{
  "realm": "janus",
  "enabled": true,
  "sslRequired": "external",
  "groups": [{ "name": "janus-admins" }, { "name": "janus-readers" }],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "alice-password", "temporary": false }],
      "groups": ["/janus-admins"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Reader",
      "credentials": [{ "type": "password", "value": "bob-password", "temporary": false }],
      "groups": ["/janus-readers"]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.test",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Nogroup",
      "credentials": [{ "type": "password", "value": "carol-password", "temporary": false }]
    },
    {
      "username": "root",
      "enabled": true,
      "email": "root@example.test",
      "emailVerified": true,
      "firstName": "Root",
      "lastName": "Collision",
      "credentials": [{ "type": "password", "value": "root-password", "temporary": false }],
      "groups": ["/janus-admins"]
    },
    {
      "username": "olga-kc",
      "enabled": true,
      "email": "olga@example.test",
      "emailVerified": true,
      "firstName": "Olga",
      "lastName": "Operator",
      "credentials": [{ "type": "password", "value": "olga-kc-password", "temporary": false }],
      "groups": ["/janus-readers"]
    }
  ],
  "clients": [
    {
      "clientId": "janus",
      "name": "Janus Controller",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "janus-sso-test-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["https://controller.test:8443/api/auth/sso/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://controller.test:8443/"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
