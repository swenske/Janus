# Filled in by hack/qemu-logforward-test.sh: @UDP@, @TCP@, @TLS@ ports.
global(
  DefaultNetstreamDriverCAFile="/etc/rsyslog-test/ca.pem"
  DefaultNetstreamDriverCertFile="/etc/rsyslog-test/server.pem"
  DefaultNetstreamDriverKeyFile="/etc/rsyslog-test/server.key"
  workDirectory="/tmp"
)
module(load="imudp")
module(load="imtcp" MaxSessions="64")
input(type="imudp" port="@UDP@" name="udp")
input(type="imtcp" port="@TCP@" name="tcp")
input(type="imtcp" port="@TLS@" name="tls" StreamDriver.Name="gtls" StreamDriver.Mode="1" StreamDriver.AuthMode="anon")

template(name="json" type="list" option.jsonf="on") {
  property(outname="input" name="inputname" format="jsonf")
  property(outname="host" name="hostname" format="jsonf")
  property(outname="app" name="app-name" format="jsonf")
  property(outname="msgid" name="msgid" format="jsonf")
  property(outname="severity" name="syslogseverity" format="jsonf")
  property(outname="facility" name="syslogfacility" format="jsonf")
  property(outname="protocol" name="protocol-version" format="jsonf")
  property(outname="msg" name="msg" format="jsonf")
}
*.* action(type="omfile" file="/out/messages.jsonl" template="json")
