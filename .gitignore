/build/
/dist/
*.img
*.iso
*.qcow2
*.ova
*.vmdk

# buf/protoc-gen-go local tool cache, if built into the repo instead of GOBIN.
/.tmp/
.local-scratch/

# User-requested: never commit this - local planning note only.
/docs/companion-site-builder-scope.md

# The docs site's build output (hack/docs-build.sh): embedded by janus-site
# when it's built, never committed - only the placeholder is.
/site/backend/docsdist/*
